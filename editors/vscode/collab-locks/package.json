{
  "name": "collab-file-locks",
  "displayName": "Collaborative File Locks",
  "description": "Prevents merge conflicts by locking files when you start editing them.",
  "version": "1.0.0",
  "publisher": "KirilMT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KirilMT/collab.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Collab",
      "properties": {
        "collab.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `collab` CLI (or `collab-watcher`). Use `${workspaceFolder}` for the repo root. When empty, the extension auto-detects `.venv/Scripts/collab.exe` (Windows) or `.venv/bin/collab` (macOS/Linux), then `PATH`."
        }
      }
    },
    "commands": [
      {
        "command": "collabLocks.showAll",
        "title": "Collab Locks: Show All Locked Files"
      },
      {
        "command": "collabLocks.releaseAll",
        "title": "Collab Locks: Release My Locks"
      },
      {
        "command": "collabLocks.openDashboard",
        "title": "Collab Locks: Open Dashboard"
      },
      {
        "command": "collabLocks.debugCheck",
        "title": "Collab Locks: Debug Status Check"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  }
}
