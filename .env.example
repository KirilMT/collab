# Example environment configuration for Collab Runtime
# Copy this to .env and fill in your credentials

# Supabase Configuration (REQUIRED for collaborative locking)
#
# SUPABASE_URL and SUPABASE_ANON_KEY below are the shared team dev project.
# The anon key is a public client key — safe to commit to a public repo.
# Security relies on Row Level Security (RLS) policies, not key secrecy.
# See supabase/schema.sql for the RLS definitions.
#
# NEVER commit SUPABASE_SERVICE_ROLE_KEY (history is permanent).
# Obtain it from a maintainer if you need force-release via the dashboard.
SUPABASE_URL=https://tvlpcoraijlzdqmnkibd.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR2bHBjb3JhaWpsemRxbW5raWJkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAyMzAyNDUsImV4cCI6MjA5NTgwNjI0NX0.o87jQDX3jFKQMl3VifVorDLy979v5un7NvQ-7O4Xedg
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # Required for force-release via dashboard

# Lock Strictness (Optional)
# Set to 1 to make git hooks block on lock errors; default 0 (warn only)
LOCK_STRICT=0

# Conflict Prevention — cross-branch / cross-PR overlap (Optional)
# Collab warns when a change you push would conflict with another unmerged
# branch. Overlap is confirmed line-by-line via `git merge-tree`, so edits to
# different parts of the same file are NOT flagged.
#
# Block the push (instead of just warning) when an overlap is detected:
# COLLAB_OVERLAP_STRICT=0
# Disable overlap checking entirely (ignored when strict is on):
# COLLAB_OVERLAP_CHECK=1
# Pre-push `git fetch` to see branches pushed from other clones:
#   auto = fetch only in strict mode (default); 1 = always; 0 = never
# COLLAB_OVERLAP_FETCH=auto
# Use file-level overlap instead of line-level `git merge-tree`:
# COLLAB_OVERLAP_LINE_LEVEL=1
# Override the auto-detected remote to compare against (e.g. upstream):
# COLLAB_OVERLAP_REMOTE=
#
# Edit-time protection across open PRs: keep a pushed branch's files CLAIMED
# (so other developers are warned/blocked as they edit) until that branch is
# merged or deleted on the remote. Requires running supabase/schema.sql once.
# COLLAB_PR_CLAIMS=0

# Development Overrides (Optional)
# Override project root detection
# COLLAB_PROJECT_ROOT=
# Friendly name shown in the dashboard header (defaults to git repo / pyproject name)
# COLLAB_PROJECT_NAME=
# Override runtime state directory
# COLLAB_HOME=
# Set to 1 in test environments
COLLAB_TEST_MODE=0
# Override PID file location
# COLLAB_PID_FILE=

# Developer Identity (Optional)
# Override git-based identity
# DEVELOPER_ID=

# PyPI/TestPyPI Packaging Tokens (Optional, never commit real tokens)
# For local packaging tests and uploads. Copy these lines to your .env (never commit real values):
TESTPYPI_TOKEN=your_testpypi_token_here
PYPI_TOKEN=your-real-pypi-token-here
