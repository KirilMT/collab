collab/dashboard/playwright-live.html
collab/dashboard/.playwright-live.html
collab/dashboard/.collab-dashboard-*.html

# Misc temp and backup files
*.bak
*.backup
*.orig
*.isorted
temp/
output/

# Collab runtime artifacts
.daemon.pid
.daemon.log
.pycharm_watcher.pid
.pycharm_watcher.log
.startup_summary.json
.shutdown_complete
.stop_request
.vscode_heartbeat

# Agent-attribution IDE hooks — generated per machine by `collab install-agent-hooks`
# (run automatically by setup-dev). These bake in an absolute, machine-specific
# .venv interpreter path, so they must NOT be committed; each machine regenerates
# them. The portable Junie guidance (.junie/guidelines.md) is committed instead.
.cursor/hooks.json
.claude/settings.json
.claude/settings.local.json
